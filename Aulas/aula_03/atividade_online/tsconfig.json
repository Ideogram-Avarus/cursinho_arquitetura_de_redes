{
  // Só para o editor enxergar tudo junto. As checagens de verdade usam
  // tsconfig.server.json (Node), tsconfig.web.json (navegador) e tsconfig.tests.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["server", "shared", "web", "tests", "*.ts"]
}
